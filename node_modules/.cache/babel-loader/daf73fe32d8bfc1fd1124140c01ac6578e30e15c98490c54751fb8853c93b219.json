{"ast":null,"code":"import{createSlice}from'@reduxjs/toolkit';import{DEFAULTS}from'constant';const voiceSlice=createSlice({name:'voice',initialState:{voiceURI:DEFAULTS.VOICE_URI,speed:DEFAULTS.VOICE_SPEED,volume:DEFAULTS.VOICE_VOLUME},reducers:{setVoiceItem(state,action){const{key,value}=action.payload;state[key]=value;},setVoice(state,action){return{...state,...action.payload};}}});const{reducer,actions}=voiceSlice;export const{setVoiceItem,setVoice}=actions;export default reducer;","map":{"version":3,"names":["createSlice","DEFAULTS","voiceSlice","name","initialState","voiceURI","VOICE_URI","speed","VOICE_SPEED","volume","VOICE_VOLUME","reducers","setVoiceItem","state","action","key","value","payload","setVoice","reducer","actions"],"sources":["C:/Users/nhath/Downloads/dynonary-english-master/dynonary-english-master/frontend/src/redux/slices/voice.slice.js"],"sourcesContent":["import { createSlice } from '@reduxjs/toolkit';\nimport { DEFAULTS } from 'constant';\n\nconst voiceSlice = createSlice({\n  name: 'voice',\n  initialState: {\n    voiceURI: DEFAULTS.VOICE_URI,\n    speed: DEFAULTS.VOICE_SPEED,\n    volume: DEFAULTS.VOICE_VOLUME,\n  },\n  reducers: {\n    setVoiceItem(state, action) {\n      const { key, value } = action.payload;\n      state[key] = value;\n    },\n    setVoice(state, action) {\n      return { ...state, ...action.payload };\n    },\n  },\n});\n\nconst { reducer, actions } = voiceSlice;\nexport const { setVoiceItem, setVoice } = actions;\nexport default reducer;\n"],"mappings":"AAAA,OAASA,WAAW,KAAQ,kBAAkB,CAC9C,OAASC,QAAQ,KAAQ,UAAU,CAEnC,KAAM,CAAAC,UAAU,CAAGF,WAAW,CAAC,CAC7BG,IAAI,CAAE,OAAO,CACbC,YAAY,CAAE,CACZC,QAAQ,CAAEJ,QAAQ,CAACK,SAAS,CAC5BC,KAAK,CAAEN,QAAQ,CAACO,WAAW,CAC3BC,MAAM,CAAER,QAAQ,CAACS,YACnB,CAAC,CACDC,QAAQ,CAAE,CACRC,YAAYA,CAACC,KAAK,CAAEC,MAAM,CAAE,CAC1B,KAAM,CAAEC,GAAG,CAAEC,KAAM,CAAC,CAAGF,MAAM,CAACG,OAAO,CACrCJ,KAAK,CAACE,GAAG,CAAC,CAAGC,KAAK,CACpB,CAAC,CACDE,QAAQA,CAACL,KAAK,CAAEC,MAAM,CAAE,CACtB,MAAO,CAAE,GAAGD,KAAK,CAAE